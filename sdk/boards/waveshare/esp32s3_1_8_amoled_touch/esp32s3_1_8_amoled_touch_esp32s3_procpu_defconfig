# waveshare 1.8 AMOELED touch
# https://files.waveshare.com/wiki/ESP32-S3-Touch-AMOLED-1.8/ESP32-S3-Touch-AMOLED-1.8.pdf

CONFIG_CONSOLE=y
CONFIG_SERIAL=y
CONFIG_UART_CONSOLE=y
CONFIG_GPIO=y

CONFIG_SPI=y
CONFIG_DMA=y
CONFIG_I2C=y

CONFIG_DISPLAY=y
CONFIG_SH8601=y
CONFIG_DISPLAY_INIT_PRIORITY=90

CONFIG_INPUT=y
CONFIG_INPUT_FT3168=y
CONFIG_INPUT_FT3168_INTERRUPT=y

CONFIG_REGULATOR=y

CONFIG_REGULATOR_AXP192_AXP2101_INIT_PRIORITY=86

CONFIG_GPIO_TCA9544APWR=y
CONFIG_GPIO_TCA9544APWR_INIT_PRIORITY=87

CONFIG_SENSOR=y
CONFIG_SENSOR_SHELL=y

CONFIG_RTC=y
CONFIG_RTC_PCF85063A=y
CONFIG_RTC_SHELL=y